# Optional. Without a key, every lesson runs offline with a scripted fake model.
ANTHROPIC_API_KEY=

# The default model is defined once, in lessons/common.py (DEFAULT_MODEL = anthropic:claude-sonnet-5-5).
# Override with any init_chat_model string:
#   LC_MODEL=anthropic:claude-opus-5-5      # most capable general model
#   LC_MODEL=anthropic:claude-haiku-5-5     # fastest / cheapest
#   LC_MODEL=anthropic:claude-fable-5-2     # top tier, long-horizon agentic work
# Other providers need BOTH their key and an explicit LC_MODEL (the default is an Anthropic model):
#   OPENAI_API_KEY=
#   LC_MODEL=openai:<model-id>             # also: pip install langchain-openai
# LC_TEMPERATURE=0     # opt in to a sampling temperature (left at the provider default otherwise)

# Optional tracing (highly recommended once you use a real model). Lessons 13-17 explain each setting.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=learn-langchain        # which LangSmith project the traces land in
# LANGSMITH_TRACING_SAMPLING_RATE=1.0      # 0.0-1.0: keep this fraction of traces (lesson 14)
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # non-US regions only
#
# The tests and lessons 13-17 never need these: they run against a local recording client.
# LANGSMITH_TEST_TRACKING=false            # run `@pytest.mark.langsmith` tests locally without a key (lesson 16)
